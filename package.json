{
  "name": "pervert",
  "description": "Take a peek under your Mac",
  "version": "0.0.1",
  "type": "module",
  "main": "index.js",
  "author": "Mike Cunneen",
  "private": true,
  "publishConfig": {
    "access": "public"
  },
  "license": "MPL-2.0",
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@dotenvx/dotenvx": "^2.21.0",
    "@preact/preset-vite": "^2.10.5",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.11",
    "chai": "^6.2.2",
    "git-cliff": "^2.13.1",
    "husky": "^9.1.7",
    "oxlint": "^1.75.0",
    "release-it": "^21.0.2",
    "ts-node": "^10.9.2",
    "tslog": "^5.1.0",
    "typescript": "~6.0.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "commitlint": "commitlint --edit",
    "dev": "vite",
    "dev-tauri": "TAURI_ENV_TSLOG_LEVEL=DEBUG tauri dev",
    "lint": "oxlint",
    "prepare": "husky",
    "preview": "vite preview",
    "release-changelog": "git-cliff --unreleased --prepend CHANGELOG.md --tag ",
    "release": "dotenvx run release-it -- -i -u",
    "tauri": "tauri",
    "test": "dotenvx run -e 'TSLOG_LEVEL=INFO' -- ./node_modules/.bin/vitest",
    "test-debug": "dotenvx run -e 'TSLOG_LEVEL=DEBUG' -- ./node_modules/.bin/vitest",
    "test-nomock": "dotenvx run -e 'DISABLE_MOCK_SUDO=true TSLOG_LEVEL=DEBUG' -- ./node_modules/.bin/vitest",
    "create-dumpbtm": "sudo sfltool dumpbtm > ./test/assets/dumpbtm.txt"
  },
  "dependencies": {
    "@tanstack/preact-devtools": "^0.10.12",
    "@tanstack/preact-table": "^9.1.2",
    "@tanstack/preact-table-devtools": "^9.2.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-log": "^2.9.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@vscode/sudo-prompt": "^9.3.2",
    "abstract-logging": "^2.0.1",
    "chevrotain": "^13.2.0",
    "preact": "^10.25.1"
  }
}
