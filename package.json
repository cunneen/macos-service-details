{
  "name": "macos-service-details",
  "description": "GUI for viewing MacOS service details",
  "version": "0.0.1",
  "type": "module",
  "main": "index.js",
  "author": "Mike Cunneen",
  "private": true,
  "publishConfig": {
    "access": "public"
  },
  "license": "MPL-2.0",
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@dotenvx/dotenvx": "^2.21.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.11",
    "chai": "^6.2.2",
    "git-cliff": "^2.13.1",
    "husky": "^9.1.7",
    "oxlint": "^1.75.0",
    "release-it": "^21.0.2",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "commitlint": "commitlint --edit",
    "dev": "vite",
    "lint": "oxlint",
    "prepare": "husky",
    "preview": "vite preview",
    "release-changelog": "git-cliff --unreleased --prepend CHANGELOG.md --tag ",
    "release": "dotenvx run release-it -- -i -u",
    "test": "dotenvx run -- ./node_modules/.bin/vitest",
    "test-nomock": "dotenvx run -e 'DISABLE_MOCK_SUDO=true' -- ./node_modules/.bin/vitest"
  },
  "dependencies": {
    "@vscode/sudo-prompt": "^9.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
