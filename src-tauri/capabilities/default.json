{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "log:default",
    "shell:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "check-groups",
          "cmd": "sh",
          "args": [
            "-c",
            "groups ${LOGNAME}"
          ],
          "sidecar": false
        },
        {
          "name": "dumpbtm",
          "cmd": "sudo",
          "args": [
            "sfltool",
            "dumpbtm"
          ],
          "sidecar": false
        },
        {
          "name": "exec-sh",
          "cmd": "sh",
          "args": [
            "-c",
            {
              "validator": "^echo .*"
            }
          ],
          "sidecar": false
        },
        {
          "name": "getUserIDs",
          "cmd": "sudo",
          "args": [
            "sh",
            "-c",
            {
              "validator": "^dscl . -list .*"
            }
          ],
          "sidecar": false
        },
        {
          "name": "getUserGUIDs",
          "cmd": "sudo",
          "args": [
            "sh",
            "-c",
            {
              "validator": "^dscl . -list .*"
            }
          ],
          "sidecar": false
        }
      ]
    }
  ]
}